#!/bin/bash
# Container Freeze - Unified CLI with Interactive Mode
# Main interface for managing the Container Freeze environment

set -e

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_ROOT"

# Source libraries
source "$PROJECT_ROOT/lib/gum.sh"
source "$PROJECT_ROOT/lib/vm.sh"
source "$PROJECT_ROOT/lib/demos.sh"

# Colors using tput (fallback for non-gum output)
if command -v tput &> /dev/null && [ -t 1 ]; then
    RED=$(tput setaf 1)
    GREEN=$(tput setaf 2)
    YELLOW=$(tput setaf 3)
    BLUE=$(tput setaf 4)
    CYAN=$(tput setaf 6)
    BOLD=$(tput bold)
    NC=$(tput sgr0)
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    CYAN=''
    BOLD=''
    NC=''
fi

# VM connection helpers
VM_DIR="$PROJECT_ROOT/vm"

# Check VM status
check_vm() {
    if load_vm_connection 2>/dev/null; then
        if $SSH -o ConnectTimeout=2 "exit" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

# Check K3s status
check_k3s() {
    if ! check_vm; then
        return 1
    fi
    load_vm_connection 2>/dev/null
    if $SSH "kubectl get nodes" 2>/dev/null | grep -q "Ready"; then
        return 0
    fi
    return 1
}

# Check if demo is deployed
check_demo_deployed() {
    if ! check_k3s; then
        return 1
    fi
    source "$VM_DIR/connection.env"
    SSH="ssh -i $SSH_KEY -o StrictHostKeyChecking=no cfuser@$VM_IP"
    if $SSH "kubectl get pods -A 2>/dev/null | grep -q Running"; then
        return 0
    fi
    return 1
}

# ============================================================================
# Interactive Menu Commands
# ============================================================================

cmd_interactive() {
    while true; do
        clear
        print_banner

        local current_demo=$(get_current_demo)
        if [ -n "$current_demo" ]; then
            gum style --foreground 8 "Current demo: $current_demo"
        fi
        echo ""

        local choice=$(gum choose \
            --cursor.foreground="14" \
            --header "Select an action:" \
            "Status" \
            "Demo" \
            "Setup" \
            "Reset" \
            "SSH" \
            "Destroy" \
            "Help" \
            "Exit")

        case "$choice" in
            Status)   cmd_status; pause_continue ;;
            Demo)     cmd_demo_interactive ;;
            Setup)    cmd_setup_interactive ;;
            Reset)    cmd_reset_interactive ;;
            SSH)      cmd_ssh ;;
            Destroy)  cmd_destroy_interactive ;;
            Help)     cmd_help | gum_pager ;;
            Exit)     exit 0 ;;
            "")       exit 0 ;;
        esac
    done
}

pause_continue() {
    echo ""
    read -p "Press ENTER to continue..."
}

cmd_demo_interactive() {
    # Build demo list
    local demo_paths=()
    local demo_names=()

    while IFS='|' read -r path name desc; do
        demo_paths+=("$path")
        demo_names+=("$name")
    done < <(list_demos_formatted)

    if [ ${#demo_names[@]} -eq 0 ]; then
        print_error "No demos found in demos/ directory"
        pause_continue
        return
    fi

    # Add Back option
    demo_names+=("Back")

    local selected=$(gum choose \
        --cursor.foreground="14" \
        --header "Select Demo Scenario:" \
        "${demo_names[@]}")

    if [ "$selected" = "Back" ] || [ -z "$selected" ]; then
        return
    fi

    # Find selected demo path
    for i in "${!demo_names[@]}"; do
        if [ "${demo_names[$i]}" = "$selected" ]; then
            cmd_demo_actions "${demo_paths[$i]}"
            return
        fi
    done
}

cmd_demo_actions() {
    local demo_path="$1"
    local demo_name=$(get_demo_info "$demo_path" "display_name")
    local demo_desc=$(get_demo_info "$demo_path" "description")

    while true; do
        clear
        gum style \
            --border rounded \
            --border-foreground 14 \
            --padding "1 2" \
            --margin "1 0" \
            "$(gum style --bold --foreground 14 "$demo_name")

$demo_desc"

        local current=$(get_current_demo)
        local demo_basename=$(basename "$demo_path")

        if [ "$current" = "$demo_basename" ]; then
            gum style --foreground 2 "[Currently deployed]"
        fi

        echo ""

        local action=$(gum choose \
            --cursor.foreground="14" \
            --header "What would you like to do?" \
            "Run Demo" \
            "Deploy Only" \
            "Update Files" \
            "Rerun from Scratch" \
            "Back")

        case "$action" in
            "Run Demo")
                if [ "$current" != "$demo_basename" ]; then
                    switch_demo "$demo_path"
                fi
                run_demo "$demo_path"
                pause_continue
                ;;
            "Deploy Only")
                if [ "$current" != "$demo_basename" ]; then
                    switch_demo "$demo_path"
                else
                    if gum confirm "Demo already deployed. Redeploy?"; then
                        switch_demo "$demo_path"
                    fi
                fi
                pause_continue
                ;;
            "Update Files")
                update_demo_files "$demo_path"
                pause_continue
                ;;
            "Rerun from Scratch")
                rerun_demo_from_scratch "$demo_path"
                pause_continue
                ;;
            "Back"|"")
                return
                ;;
        esac
    done
}

cmd_setup_interactive() {
    clear
    print_banner

    if ! check_vm; then
        gum style --foreground 3 "VM not running. Starting full setup..."
        echo ""

        if gum confirm "This will create a new VM and install K3s. Continue?"; then
            gum_spin "Creating VM..." "$PROJECT_ROOT/vm/setup-vm.sh"
            gum_spin "Installing K3s..." "$PROJECT_ROOT/vm/install-k3s.sh"

            # Now select and deploy a demo
            echo ""
            gum style --foreground 14 "Setup complete! Now select a demo to deploy:"
            echo ""
            cmd_demo_interactive
        fi
    else
        gum style --foreground 2 "VM is already running."
        echo ""

        if ! check_k3s; then
            if gum confirm "K3s not running. Install K3s?"; then
                gum_spin "Installing K3s..." "$PROJECT_ROOT/vm/install-k3s.sh"
            fi
        else
            gum style --foreground 2 "K3s is already running."

            local current=$(get_current_demo)
            if [ -n "$current" ]; then
                gum style --foreground 8 "Current demo: $current"
            fi
        fi
        pause_continue
    fi
}

cmd_reset_interactive() {
    clear
    print_banner

    gum style --foreground 3 "This will destroy the VM and create it again"
    echo ""

    if gum confirm "Continue with reset?"; then
        # Prompt for sudo password upfront
        echo "Requesting sudo access..."
        sudo -v

        gum_spin "Destroying VM..." "$PROJECT_ROOT/destroy.sh"
        # Clear current demo state
        rm -f "$CURRENT_DEMO_FILE"

        gum_spin "Creating VM..." "$PROJECT_ROOT/vm/setup-vm.sh"
        gum_spin "Installing K3s..." "$PROJECT_ROOT/vm/install-k3s.sh"

        print_success "Reset complete! VM has been recreated."
        echo ""
        gum style --foreground 14 "You can now deploy a demo."
    fi
    pause_continue
}

cmd_destroy_interactive() {
    clear
    print_banner

    gum style --foreground 1 --bold "WARNING: This will destroy the VM and all data!"
    echo ""

    if gum confirm --default=false "Are you sure you want to destroy everything?"; then
        # Prompt for sudo password upfront
        echo "Requesting sudo access..."
        sudo -v

        "$PROJECT_ROOT/destroy.sh"
        # Clear current demo state
        rm -f "$CURRENT_DEMO_FILE"
        print_success "Environment destroyed"
    fi
    pause_continue
}

# ============================================================================
# Non-Interactive Commands (CLI mode)
# ============================================================================

cmd_status() {
    echo ""
    gum style \
        --border double \
        --border-foreground 14 \
        --padding "0 2" \
        "CONTAINER FREEZE - Status"
    echo ""

    echo "${BOLD}Environment:${NC}"
    if check_vm; then
        print_success "VM is running"
        source "$VM_DIR/connection.env"
        echo "  IP: ${CYAN}$VM_IP${NC}"
    else
        print_error "VM is not running"
    fi

    if check_k3s; then
        print_success "K3s cluster is running"
        source "$VM_DIR/connection.env"
        SSH="ssh -i $SSH_KEY -o StrictHostKeyChecking=no cfuser@$VM_IP"
        echo "  Nodes:"
        $SSH "kubectl get nodes" 2>/dev/null | tail -n +2 | sed 's/^/    /'
    else
        print_error "K3s cluster is not running"
    fi

    local current=$(get_current_demo)
    if [ -n "$current" ]; then
        echo ""
        echo "${BOLD}Current Demo:${NC} ${CYAN}$current${NC}"

        if check_demo_deployed; then
            print_success "Demo workloads are deployed"
            echo ""
            echo "${BOLD}Pods:${NC}"
            source "$VM_DIR/connection.env"
            SSH="ssh -i $SSH_KEY -o StrictHostKeyChecking=no cfuser@$VM_IP"
            $SSH "kubectl get pods -A 2>/dev/null | grep -v kube-system | grep -v ^NAMESPACE" | sed 's/^/  /' || true
        fi
    else
        print_warning "No demo deployed"
    fi

    echo ""

    # List available demos
    echo "${BOLD}Available Demos:${NC}"
    while IFS='|' read -r path name desc; do
        local mark=" "
        if [ "$(basename "$path")" = "$current" ]; then
            mark="${GREEN}*${NC}"
        fi
        echo "  $mark $name"
    done < <(list_demos_formatted)

    echo ""
}

cmd_setup() {
    gum style --border rounded --padding "0 2" "Container Freeze - Setup"
    echo ""
    "$PROJECT_ROOT/setup.sh" "$@"
}

cmd_demo_cli() {
    local demo_name="$1"

    if [ -z "$demo_name" ]; then
        # List demos and exit
        echo "Available demos:"
        while IFS='|' read -r path name desc; do
            echo "  $(basename "$path"): $name"
        done < <(list_demos_formatted)
        echo ""
        echo "Usage: cfreeze demo <demo-name>"
        return 1
    fi

    local demo_path="$DEMOS_DIR/$demo_name"
    if [ ! -d "$demo_path" ]; then
        print_error "Demo '$demo_name' not found"
        return 1
    fi

    local current=$(get_current_demo)
    if [ "$current" != "$demo_name" ]; then
        echo "Switching to demo: $demo_name"
        switch_demo "$demo_path"
    fi

    run_demo "$demo_path"
}

cmd_rerun_cli() {
    local demo_name="$1"

    if [ -z "$demo_name" ]; then
        # Use current demo or show usage
        demo_name=$(get_current_demo)
        if [ -z "$demo_name" ]; then
            print_error "No demo specified and no current demo deployed"
            echo ""
            echo "Available demos:"
            while IFS='|' read -r path name desc; do
                echo "  $(basename "$path"): $name"
            done < <(list_demos_formatted)
            echo ""
            echo "Usage: cfreeze rerun [demo-name]"
            return 1
        fi
    fi

    local demo_path="$DEMOS_DIR/$demo_name"
    if [ ! -d "$demo_path" ]; then
        print_error "Demo '$demo_name' not found"
        return 1
    fi

    rerun_demo_from_scratch "$demo_path"
}

cmd_reset() {
    gum style --border rounded --padding "0 2" "Container Freeze - Reset"
    echo ""

    # Prompt for sudo password upfront
    echo "Requesting sudo access..."
    sudo -v

    print_step "Destroying VM..."
    "$PROJECT_ROOT/destroy.sh"
    # Clear current demo state
    rm -f "$CURRENT_DEMO_FILE"

    print_step "Creating VM..."
    "$PROJECT_ROOT/vm/setup-vm.sh"

    print_step "Installing K3s..."
    "$PROJECT_ROOT/vm/install-k3s.sh"

    print_success "Reset complete! VM has been recreated."
    echo ""
    echo "You can now deploy a demo with: cfreeze demo <demo-name>"
}

cmd_cleanup() {
    gum style --border rounded --padding "0 2" "Container Freeze - Cleanup"
    echo ""
    "$PROJECT_ROOT/cleanup-cluster.sh"
}

cmd_destroy() {
    gum style --border rounded --padding "0 2" "Container Freeze - Destroy"
    echo ""

    # Prompt for sudo password upfront
    echo "Requesting sudo access..."
    sudo -v

    "$PROJECT_ROOT/destroy.sh"
    rm -f "$CURRENT_DEMO_FILE"
}

cmd_ssh() {
    if ! check_vm; then
        print_error "VM not running"
        exit 1
    fi
    "$VM_DIR/ssh.sh"
}

cmd_update_files_cli() {
    local demo_name="$1"

    if [ -z "$demo_name" ]; then
        # Use current demo or show usage
        demo_name=$(get_current_demo)
        if [ -z "$demo_name" ]; then
            print_error "No demo specified and no current demo deployed"
            echo ""
            echo "Usage: cfreeze update-files [demo-name]"
            return 1
        fi
    fi

    local demo_path="$DEMOS_DIR/$demo_name"
    if [ ! -d "$demo_path" ]; then
        print_error "Demo '$demo_name' not found"
        return 1
    fi

    update_demo_files "$demo_path"
}

cmd_list_demos() {
    echo "Available demos:"
    echo ""
    while IFS='|' read -r path name desc; do
        local current=$(get_current_demo)
        local mark="  "
        if [ "$(basename "$path")" = "$current" ]; then
            mark="${GREEN}* ${NC}"
        fi
        echo "$mark${BOLD}$name${NC} ($(basename "$path"))"
        echo "    $desc"
        echo ""
    done < <(list_demos_formatted)
}

cmd_help() {
    cat << EOF
CONTAINER FREEZE - Kubernetes Forensics & Live Containment

USAGE:
  cfreeze                     Interactive mode (recommended)
  cfreeze <command> [args]    CLI mode

COMMANDS:
  status              Show environment status (VM, K3s, current demo)
  setup               Full setup (VM + K3s), then select demo
  demo [name]         Select and run a demo interactively, or run specific demo
  rerun [name]        Rerun demo from scratch (reset + redeploy + run)
  update-files [name] Update demo files only (no image rebuild, no redeploy)
  list-demos          List all available demo scenarios
  reset               Destroy VM and recreate it from scratch (VM + K3s)
  cleanup             Remove K3s cluster only (preserves VM)
  destroy             Full cleanup (removes VM and all data)
  ssh                 SSH into the VM
  help                Show this help message

INTERACTIVE MODE:
  Run 'cfreeze' with no arguments for an interactive menu.
  Navigate with arrow keys and Enter.

DEMO WORKFLOW:
  cfreeze                    # Start interactive mode
  > Setup                    # Create VM + K3s
  > Demo                     # Select and run a demo
  > Reset                    # Reset for another run

CLI WORKFLOW:
  cfreeze setup                    # Create VM + K3s
  cfreeze demo payment-breach      # Run specific demo
  cfreeze rerun payment-breach     # Reset + redeploy + run demo
  cfreeze rerun                    # Rerun current demo from scratch
  cfreeze update-files             # Sync local file changes to VM
  cfreeze reset                    # Reset cluster
  cfreeze destroy                  # Cleanup when done

DEMO SWITCHING:
  When switching between demos, the K3s cluster is fully reset
  to ensure a clean state. This takes about 1-2 minutes.

RERUN FROM SCRATCH:
  The 'rerun' command performs a complete reset, redeploy, and run:
  1. Cleans and reinstalls K3s cluster
  2. Redeploys the demo from scratch
  3. Automatically runs the demo

UPDATE FILES:
  The 'update-files' command syncs local demo files to the VM without:
  - Rebuilding container images
  - Reapplying Kubernetes deployments
  Useful for quickly iterating on scripts like run.sh or detection policies.

MORE INFO:
  Demos are located in the demos/ directory.
  Each demo has its own application, attack, and detection policies.

EOF
}

# ============================================================================
# Main Entry Point
# ============================================================================

main() {
    # No args = interactive mode
    if [ $# -eq 0 ]; then
        check_gum_installed
        cmd_interactive
        return
    fi

    local cmd="${1}"
    shift

    case "$cmd" in
        status|st)
            cmd_status "$@"
            ;;
        setup)
            check_gum_installed
            cmd_setup_interactive
            ;;
        demo)
            if [ $# -eq 0 ]; then
                check_gum_installed
                cmd_demo_interactive
            else
                check_gum_installed
                cmd_demo_cli "$@"
            fi
            ;;
        rerun)
            check_gum_installed
            cmd_rerun_cli "$@"
            ;;
        update-files|update)
            cmd_update_files_cli "$@"
            ;;
        list-demos|demos)
            cmd_list_demos
            ;;
        reset)
            check_gum_installed
            cmd_reset
            ;;
        cleanup|clean)
            cmd_cleanup "$@"
            ;;
        destroy)
            check_gum_installed
            cmd_destroy_interactive
            ;;
        ssh)
            cmd_ssh
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            print_error "Unknown command: $cmd"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
