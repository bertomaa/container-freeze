#!/bin/bash
# Container Freeze - Unified CLI
# Main interface for managing the Container Freeze POC environment

set -e

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_ROOT"

# Colors using tput (more portable)
if command -v tput &> /dev/null && [ -t 1 ]; then
    RED=$(tput setaf 1)
    GREEN=$(tput setaf 2)
    YELLOW=$(tput setaf 3)
    BLUE=$(tput setaf 4)
    CYAN=$(tput setaf 6)
    BOLD=$(tput bold)
    NC=$(tput sgr0)
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    CYAN=''
    BOLD=''
    NC=''
fi

# Helper functions
print_header() {
    echo "${CYAN}╔════════════════════════════════════════════════════════════════╗${NC}"
    echo "${CYAN}║${NC} ${BOLD}$1${NC}"
    echo "${CYAN}╚════════════════════════════════════════════════════════════════╝${NC}"
}

print_step() {
    echo "${BLUE}▶${NC} ${BOLD}$1${NC}"
}

print_success() {
    echo "${GREEN}✓${NC} $1"
}

print_warning() {
    echo "${YELLOW}⚠${NC} $1"
}

print_error() {
    echo "${RED}✗${NC} $1"
}

# Check VM status
check_vm() {
    if [ -f "./vm/connection.env" ]; then
        source ./vm/connection.env
        if ssh -i "$SSH_KEY" -o StrictHostKeyChecking=no -o ConnectTimeout=2 cfuser@"$VM_IP" "exit" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

# Check K3s status
check_k3s() {
    if ! check_vm; then
        return 1
    fi
    source ./vm/connection.env
    SSH="ssh -i $SSH_KEY -o StrictHostKeyChecking=no cfuser@$VM_IP"
    if $SSH "kubectl get nodes" 2>/dev/null | grep -q "Ready"; then
        return 0
    fi
    return 1
}

# Check POC deployment status
check_poc() {
    if ! check_k3s; then
        return 1
    fi
    source ./vm/connection.env
    SSH="ssh -i $SSH_KEY -o StrictHostKeyChecking=no cfuser@$VM_IP"
    if $SSH "kubectl get pods -n production 2>/dev/null | grep payment-processor | grep -q Running"; then
        return 0
    fi
    return 1
}

# Show status
cmd_status() {
    echo ""
    cat << 'EOF'
          ❄ ░▒▓  CONTAINER FREEZE  ▓▒░ ❄
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                   System Status
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EOF
    echo ""

    echo "${BOLD}Environment:${NC}"
    if check_vm; then
        print_success "VM is running"
        source ./vm/connection.env
        echo -e "  IP: ${CYAN}$VM_IP${NC}"
    else
        print_error "VM is not running"
    fi

    if check_k3s; then
        print_success "K3s cluster is running"
        SSH="ssh -i $SSH_KEY -o StrictHostKeyChecking=no cfuser@$VM_IP"
        echo -e "  Nodes:"
        $SSH "kubectl get nodes" | tail -n +2 | sed 's/^/    /'
    else
        print_error "K3s cluster is not running"
    fi

    if check_poc; then
        print_success "POC workloads are deployed"
        echo -e "\n${BOLD}Pods:${NC}"
        $SSH "kubectl get pods -A | grep -E 'production|attacker|tetragon'" | sed 's/^/  /'
    else
        print_warning "POC workloads are not deployed"
    fi

    if check_vm; then
        echo -e "\n${BOLD}Docker Images:${NC}"
        $SSH "sudo docker images | grep -E 'localhost/|REPOSITORY'" | sed 's/^/  /' || print_warning "No images built"
    fi

    echo ""
}

# Setup command
cmd_setup() {
    print_header "Container Freeze - Full Setup"
    echo ""
    ./setup.sh "$@"
}

# Demo command
cmd_demo() {
    print_header "Container Freeze - Running Demo"
    echo ""
    if ! check_poc; then
        print_error "POC not deployed. Run 'cfreeze setup' first"
        exit 1
    fi
    ./demo.sh "$@"
}

# Build images command
cmd_build() {
    print_header "Container Freeze - Building Images"
    echo ""
    ./build-images.sh
}

# Cleanup cluster command
cmd_cleanup() {
    print_header "Container Freeze - Cluster Cleanup"
    echo ""
    ./cleanup-cluster.sh
}

# Reset command (cleanup + reinstall K3s + redeploy)
cmd_reset() {
    echo ""
    cat << 'EOF'
          ❄ ░▒▓  CONTAINER FREEZE  ▓▒░ ❄
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
              Quick Reset: Melt & Refreeze
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EOF
    echo ""

    if ! check_vm; then
        print_error "VM not running. Run 'cfreeze setup' first"
        exit 1
    fi

    print_step "Step 1/3: Cleaning up K3s cluster..."
    ./cleanup-cluster.sh

    echo ""
    print_step "Step 2/3: Reinstalling K3s..."
    ./vm/install-k3s.sh

    echo ""
    print_step "Step 3/3: Deploying POC..."
    ./vm/deploy-poc.sh

    echo ""
    cat << 'EOF'
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
            ❄ Reset Complete - Refrozen! ❄
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EOF
    echo ""
    print_success "Cluster has been reset and POC redeployed"
    echo ""
    echo "Run the demo:"
    echo "  ${CYAN}cfreeze demo${NC}"
    echo ""
}

# Destroy command
cmd_destroy() {
    print_header "Container Freeze - Full Cleanup"
    echo ""
    ./destroy.sh
}

# SSH command
cmd_ssh() {
    if ! check_vm; then
        print_error "VM not running"
        exit 1
    fi
    ./vm/ssh.sh
}

