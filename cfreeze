# Show help
cmd_help() {
    print_banner
    echo ""
    cat << EOF
${BOLD}USAGE:${NC}
  cfreeze <command> [options]

${BOLD}COMMANDS:${NC}
  ${GREEN}status${NC}              Show environment status (VM, K3s, POC, images)

  ${GREEN}setup${NC}               Full setup (VM + K3s + POC deployment)
                      Options: --external-c2 <IP>

  ${GREEN}build${NC}               Build container images locally (faster subsequent setups)

  ${GREEN}demo${NC}                Run the full attack demo
                      Options: --external-c2 <IP>

  ${GREEN}reset${NC}               Quick reset: cleanup cluster + reinstall K3s + redeploy POC
                      ${YELLOW}Preserves:${NC} VM and Docker images
                      ${YELLOW}Time:${NC} ~1-2 minutes vs ~4 minutes full setup

  ${GREEN}cleanup${NC}             Remove K3s cluster only
                      ${YELLOW}Preserves:${NC} VM and Docker images

  ${GREEN}destroy${NC}             Full cleanup (VM + all resources)

  ${GREEN}ssh${NC}                 SSH into the VM

  ${GREEN}help${NC}                Show this help message

${BOLD}WORKFLOW:${NC}
  ${CYAN}# First time setup${NC}
  cfreeze setup

  ${CYAN}# Optional: Build images for faster redeployment${NC}
  cfreeze build

  ${CYAN}# Run demo${NC}
  cfreeze demo

  ${CYAN}# Quick reset for another demo${NC}
  cfreeze reset

  ${CYAN}# Check status anytime${NC}
  cfreeze status

  ${CYAN}# Full cleanup when done${NC}
  cfreeze destroy

${BOLD}EXAMPLES:${NC}
  cfreeze status
  cfreeze setup
  cfreeze demo
  cfreeze reset
  cfreeze setup --external-c2 192.168.1.50
  cfreeze ssh

${BOLD}MORE INFO:${NC}
  GitHub: https://github.com/bertomaa/container-freeze
  Docs:   README.md
EOF
}

# Main command router
main() {
    # Show banner if no command given
    if [ $# -eq 0 ]; then
        print_banner
        echo ""
        echo "Run ${CYAN}cfreeze help${NC} to see available commands"
        echo "Run ${CYAN}cfreeze status${NC} to check environment status"
        echo ""
        exit 0
    fi

    local cmd="${1}"
    shift

    case "$cmd" in
        status|st)
            cmd_status "$@"
            ;;
        setup)
            cmd_setup "$@"
            ;;
        build)
            cmd_build "$@"
            ;;
        demo|run)
            cmd_demo "$@"
            ;;
        cleanup|clean)
            cmd_cleanup "$@"
            ;;
        reset|restart)
            cmd_reset "$@"
            ;;
        destroy)
            cmd_destroy "$@"
            ;;
        ssh)
            cmd_ssh "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            print_error "Unknown command: $cmd"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
